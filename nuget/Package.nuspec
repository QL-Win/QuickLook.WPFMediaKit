<?xml version="1.0"?>
<package >
  <metadata>
    <id>QuickLook.WPFMediaKit</id>
    <version>3.0.1</version>
    <authors>WPF MediaKit Team</authors>
    <owners>WPF MediaKit Team</owners>
    <icon>app.png</icon>
    <licenseUrl>https://github.com/QL-Win/QuickLook.WPFMediaKit/blob/master/LICENSE</licenseUrl>
    <projectUrl>https://github.com/QL-Win/QuickLook.WPFMediaKit</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>This package is part of QuickLook program. A library to quickly build DirectShow and MediaFoundation media player controls in WPF. The kit comes with a MediaElement replacement, a VideoCaptureElement for web cams and a DVDPlayerElement that plays DVDs and supports interactive menus.</description>
    <releaseNotes>Adds .NET 10 support and System Media Transport Controls integration. DirectShowLib now comes from the DirectShowLib.Standard package instead of the bundled DirectShowLib-2005.dll. See https://github.com/QL-Win/QuickLook.WPFMediaKit/blob/master/CHANGELOG.md</releaseNotes>
    <copyright>Copyright © 2015-2026 by WPF MediaKit Team and QL-Win Team</copyright>
    <tags>wpf video directshow evr dvd player media MediaFoundation</tags>
    <dependencies>
      <group targetFramework="net462">
        <dependency id="DirectShowLib.Standard" version="2.1.0" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <dependency id="DirectShowLib.Standard" version="2.1.0" />
      </group>
    </dependencies>
   </metadata>
  <files>
  <file src=".\app.png" target="" />
  <file src="WPFMediaKit.targets" target="build\QuickLook.WPFMediaKit.targets" />
  <file src="..\Source\bin\Release\net462\QuickLook.WPFMediaKit.dll" target="lib\net462\QuickLook.WPFMediaKit.dll" />
  <file src="..\Source\bin\Release\net462\QuickLook.WPFMediaKit.pdb" target="lib\net462\QuickLook.WPFMediaKit.pdb" />
  <file src="..\Source\bin\Release\net462\QuickLook.WPFMediaKit.xml" target="lib\net462\QuickLook.WPFMediaKit.xml" />
  <file src="..\Source\bin\Release\net10.0-windows\QuickLook.WPFMediaKit.dll" target="lib\net10.0-windows7.0\QuickLook.WPFMediaKit.dll" />
  <file src="..\Source\bin\Release\net10.0-windows\QuickLook.WPFMediaKit.pdb" target="lib\net10.0-windows7.0\QuickLook.WPFMediaKit.pdb" />
  <file src="..\Source\bin\Release\net10.0-windows\QuickLook.WPFMediaKit.xml" target="lib\net10.0-windows7.0\QuickLook.WPFMediaKit.xml" />
  <file src="..\EVR Presenter\bin\Release\x86\EVRPresenter32.dll" target="build\EVRPresenter32.dll"/>
  <file src="..\EVR Presenter\bin\Release\x64\EVRPresenter64.dll" target="build\EVRPresenter64.dll" />
  <file src="..\EVR Presenter\bin\Release\x86\EVRPresenter32.dll" target="runtimes\win-x86\native\EVRPresenter32.dll" />
  <file src="..\EVR Presenter\bin\Release\x64\EVRPresenter64.dll" target="runtimes\win-x64\native\EVRPresenter64.dll" />
  </files> 
</package>