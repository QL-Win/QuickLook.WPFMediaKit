<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net462;net10.0-windows</TargetFrameworks>
    <RootNamespace>WPFMediaKit</RootNamespace>
    <AssemblyName>QuickLook.WPFMediaKit</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>${NoWarn};CA1416;CS1591;CS8073;SYSLIB0003;SYSLIB0032;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DirectShowLib-2005">
      <HintPath>Assemblies\DirectShowLib-2005.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Effects\DeeperColor.ps" />
    <Content Include="Effects\DeeperColor.fx" />
  </ItemGroup>

</Project>