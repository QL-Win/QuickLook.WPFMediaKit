<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <TargetFramework>net462</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>WPFMediaKit</RootNamespace>
    <AssemblyName>QuickLook.WPFMediaKit</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>${NoWarn};CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DocumentationFile>bin\Release\QuickLook.WPFMediaKit.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DirectShowLib-2005">
      <HintPath>Assemblies\DirectShowLib-2005.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Effects\DeeperColor.ps" />
    <Content Include="Effects\DeeperColor.fx" />
  </ItemGroup>

</Project>